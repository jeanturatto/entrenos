# Copie este arquivo para .env.local quando o projeto Supabase estiver disponível.
# A chave publishable pode existir no cliente; nunca use secret/service_role aqui.
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto-dev.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=substitua-pela-chave-publicavel

# Use "studio" somente para revisar o catálogo visual e o protótipo interno.
EXPO_PUBLIC_APP_MODE=client
