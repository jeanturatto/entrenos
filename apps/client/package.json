{
  "name": "@entrenos/client",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:go:tunnel": "expo start --go --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:mobile": "expo export --platform android --platform ios --output-dir dist/mobile",
    "deploy:web:production": "pnpm export:web && npx eas-cli@latest deploy --prod --environment production --export-dir dist/web --non-interactive"
  },
  "dependencies": {
    "@entrenos/domain": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "2.112.0",
    "@tanstack/react-query": "5.101.4",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.0",
    "@types/react": "~19.1.17",
    "eslint": "^9.39.2",
    "eslint-config-expo": "10.0.0",
    "typescript": "~5.9.3",
    "vitest": "4.1.10"
  }
}
